user_data.json

# ============================================
# ADDED: Working data artifacts
# ============================================
# The workbook (.xlsx) is the tracked source of truth that the
# app loads at startup. The CSV is a working artifact for sheet
# editing; it drifts from the workbook during cleanup passes.
comprehensive_grocery_certifications_COMPLETE*.csv
comprehensive_grocery_certifications_COMPLETE.csv.*

# Audit artifact from category-mismatch scan. Kept locally for
# future review; regenerated each time the scan runs, so it
# should not be committed.
suspicious_pairings.csv

# ============================================
# ADDED: One-time migration/audit scripts
# ============================================
# Migration and diagnostic scripts that have already run and
# should not ship with the app. If you need to rerun one,
# copy it from backups/ or re-create it.
audit_*.py
migrate_*.py
compare_*.py
test_column_*.py
*_test.txt

# Backups directory (contains .bak, .pre-*, and old versions)
backups/
